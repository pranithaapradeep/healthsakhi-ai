# HealthSakhi AI — configuration overview. Placeholder values only; never commit real secrets.
# Backend settings live in backend/.env (template: backend/.env.example).
# Frontend settings live in frontend/.env (template: frontend/.env.example).
#
# backend/.env
#   ENVIRONMENT=development
#   DATABASE_URL=postgresql+psycopg://healthsakhi:CHANGE_ME@localhost:5432/healthsakhi
#   CORS_ORIGINS=http://localhost:5173
#   COOKIE_SAMESITE=lax
#   AI_PROVIDER=groq              (groq | anthropic | none — no automatic fallback)
#   GROQ_API_KEY=                 (free tier: https://console.groq.com/keys)
#   GROQ_MODEL=openai/gpt-oss-120b
#   ANTHROPIC_API_KEY=            (only if AI_PROVIDER=anthropic; paid)
#
# frontend/.env
#   VITE_API_BASE_URL=            (empty in development; Vite proxies /api to :8000)
