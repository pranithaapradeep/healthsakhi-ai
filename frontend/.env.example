# Base URL of the deployed backend, e.g. https://healthsakhi-api.onrender.com
# Leave empty for local development (Vite proxies /api to http://localhost:8000).
VITE_API_BASE_URL=

# Map tiles. Default: OpenStreetMap standard tiles (development / light use only, attribution required, no SLA).
# For production, use a tile provider whose terms allow your traffic, and set its attribution.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
