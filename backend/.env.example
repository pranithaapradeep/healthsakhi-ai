# Copy to backend/.env and fill in. Placeholder values only — never commit the real file.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://healthsakhi:CHANGE_ME@localhost:5432/healthsakhi
CORS_ORIGINS=http://localhost:5173
# Production behind HTTPS on a different site from the frontend: COOKIE_SAMESITE=none (forces Secure cookies)
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168

# AI chat. Choose ONE provider explicitly: groq | anthropic | none
# There is no automatic fallback: if the chosen provider's key is missing, chat answers "AI not configured".
AI_PROVIDER=groq

# Groq (free tier available). Create a key at https://console.groq.com/keys — keep it only in this file.
GROQ_API_KEY=
# Production model, Groq's recommended replacement for the deprecated Llama 3.x models (checked Oct 2026).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=1536
# Prior messages sent as context with Groq (free tier allows ~8K tokens per minute; Tamil/Hindi use many tokens).
GROQ_CONTEXT_MESSAGES=8

# Anthropic Claude (paid, per token; no free tier). Only used when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# low | medium | high — lower is faster and cheaper
CLAUDE_EFFORT=medium
AI_MAX_TOKENS=2048

AI_TIMEOUT_SECONDS=45
CHAT_HISTORY_MESSAGES=20
CHAT_RATE_LIMIT=10

# Hospital finder: osm | none. OpenStreetMap public servers — free, no key, but fair-use only and no SLA.
# osm = live Overpass | snapshot = offline OSM copy (build it first: scripts/build_hospital_snapshot.py) | none
HOSPITAL_PROVIDER=osm
# With HOSPITAL_PROVIDER=snapshot: osm = use live Overpass if the copy is missing or can't answer; none = never
HOSPITAL_FALLBACK_PROVIDER=osm
HOSPITAL_SNAPSHOT_PATH=data/hospitals-india.json.gz
# REQUIRED by the Nominatim usage policy: a real contact email or project URL (sent in the User-Agent).
OSM_CONTACT=
# true only if scripts/diagnose_hospitals.py shows IPv6 connections to OSM servers stalling
OSM_IPV4_ONLY=false
# Production: point these at a self-hosted or paid instance.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
HOSPITAL_RATE_LIMIT=10
# Total time budget for one hospital search (queue wait + Overpass). The public server often needs 20–30 s.
HOSPITAL_TIMEOUT_SECONDS=40
NOMINATIM_TIMEOUT_SECONDS=10
HOSPITAL_CACHE_TTL_SECONDS=3600

# Place suggestions while typing: photon | none. Public Photon: "reasonable" use only, no availability guarantee.
PLACE_SUGGEST_PROVIDER=photon
PHOTON_URL=https://photon.komoot.io/api
PLACE_SUGGEST_RATE_LIMIT=30
PLACE_SUGGEST_TIMEOUT_SECONDS=4

# Tests only: a SEPARATE database whose name ends in _test. Leave unset to test on in-memory SQLite.
# TEST_DATABASE_URL=postgresql+psycopg://healthsakhi:CHANGE_ME@localhost:5432/healthsakhi_test
